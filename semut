#!/bin/sh
# semut — tiny native desktop apps: a WKWebView window, a Tov backend, your HTML.
#
#   semut new <name> [dir]   scaffold an app
#   semut dev                run it; frontend edits reload, backend edits rebuild
#   semut check              type-check the backend (tov check)
#   semut build [-Os]        dist/<Title>.app, ad-hoc signed
#   semut launcher           (re)build the cached launcher only
#
# Written in sh, not Tov: the CLI has to spawn clang, tov and the launcher,
# and Tov has no child processes yet.
set -eu

die() { printf 'semut: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

# Where this script really lives (follow symlinks, e.g. from ~/.local/bin).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
ROOT=$(cd "$(dirname "$self")" && pwd)
CACHE=${SEMUT_CACHE:-$HOME/Library/Caches/semut}
LAUNCHER=$CACHE/launcher

[ "$(uname -s)" = Darwin ] || die "only macOS is supported so far (the launcher is AppKit + WKWebView)"

need_tov() {
  command -v tov >/dev/null 2>&1 || die "tov not found: install it with \`curl -fsSL https://tov.sh/install.sh | sh\`"
}

# Read a key from semut.json (plutil reads JSON on macOS).
conf() {
  plutil -extract "$1" raw -o - semut.json 2>/dev/null || printf '%s' "${2:-}"
}

in_app() {
  [ -f semut.json ] || die "no semut.json here; run this in an app made by \`semut new\`"
  [ -f frontend/index.html ] || die "frontend/index.html is missing"
}

# The launcher is built once per semut version and cached; it is rebuilt
# whenever its source or the page client is newer than the binary.
build_launcher() {
  src=$ROOT/native/launcher-macos.m
  client=$ROOT/runtime/semut.js
  if [ -x "$LAUNCHER" ] && [ "$LAUNCHER" -nt "$src" ] && [ "$LAUNCHER" -nt "$client" ]; then
    return 0
  fi
  say "semut: building the launcher..."
  mkdir -p "$CACHE/gen"
  (cd "$ROOT/runtime" && xxd -i -n semut_client_js semut.js) > "$CACHE/gen/client.h"
  clang -fobjc-arc -Os -Wall -Wno-unused-function -mmacosx-version-min=12.0 \
    -I"$CACHE/gen" "$src" -framework Cocoa -framework WebKit \
    -o "$LAUNCHER.tmp"
  strip -x "$LAUNCHER.tmp" 2>/dev/null || true
  mv "$LAUNCHER.tmp" "$LAUNCHER"
}

# Tov imports are relative, so each app carries a copy of the SDK.
vendor_sdk() {
  if ! cmp -s "$ROOT/runtime/semut.tov" backend/semut.tov 2>/dev/null; then
    cp "$ROOT/runtime/semut.tov" backend/semut.tov
  fi
}

has_backend() { [ -f backend/main.tov ]; }

# Build to a temp name and rename, so a running launcher never execs a
# half-written binary and a failed build keeps the last good one.
build_backend() {
  out=$1; shift
  tov build backend/main.tov -o "$out.tmp" "$@" || { rm -f "$out.tmp"; return 1; }
  mv "$out.tmp" "$out"
}

cmd_new() {
  [ $# -ge 1 ] || die "usage: semut new <name> [dir]"
  name=$1
  dir=${2:-$name}
  case $name in *[!A-Za-z0-9_-]*|'') die "name may only use letters, digits, - and _" ;; esac
  [ -e "$dir" ] && die "$dir already exists"
  mkdir -p "$dir"
  cp -R "$ROOT/template/." "$dir/"
  mv "$dir/gitignore" "$dir/.gitignore"
  for f in "$dir/semut.json" "$dir/frontend/index.html"; do
    sed -i '' "s/__NAME__/$name/g" "$f"
  done
  cp "$ROOT/runtime/semut.tov" "$dir/backend/semut.tov"
  cp "$ROOT/docs/AGENTS.md" "$dir/AGENTS.md"
  say "Created $dir"
  say ""
  say "  cd $dir"
  say "  semut dev      # window opens; edits reload"
  say "  semut build    # dist/$name.app"
}

cmd_check() {
  in_app; need_tov
  has_backend || { say "no backend/main.tov: nothing to check"; return 0; }
  vendor_sdk
  tov check "$@" backend
}

cmd_dev() {
  in_app; build_launcher
  mkdir -p .semut
  backend_bin=
  if has_backend; then
    need_tov; vendor_sdk
    backend_bin=$PWD/.semut/backend
    touch .semut/stamp-backend
    build_backend "$backend_bin" -O1 || die "backend didn't build; fix the errors above and run semut dev again"
  fi
  touch .semut/stamp-frontend

  SEMUT_FRONTEND=$PWD/frontend SEMUT_BACKEND=$backend_bin \
  SEMUT_NAME=$(conf name semut) SEMUT_TITLE=$(conf title "$(conf name semut)") \
  SEMUT_SIZE=$(conf size 960x640) SEMUT_VERSION=$(conf version 0.0.0) \
  SEMUT_APP_ID=$(conf id "$(conf name semut)") SEMUT_DEV=1 \
    "$LAUNCHER" &
  pid=$!
  trap 'kill $pid 2>/dev/null; exit 0' INT TERM
  say "semut: running (pid $pid). Ctrl-C to quit."

  # Poll for edits. Frontend: SIGUSR2 reloads the page. Backend: rebuild,
  # then SIGUSR1 restarts it (calls in flight are rejected, queued ones kept).
  while kill -0 "$pid" 2>/dev/null; do
    sleep 0.4
    if [ -n "$(find frontend -type f -newer .semut/stamp-frontend 2>/dev/null | head -n 1)" ]; then
      touch .semut/stamp-frontend
      kill -USR2 "$pid" 2>/dev/null || true
      say "semut: reloaded page"
    fi
    if [ -n "$backend_bin" ] && [ -n "$(find backend -name '*.tov' -newer .semut/stamp-backend 2>/dev/null | head -n 1)" ]; then
      touch .semut/stamp-backend
      say "semut: rebuilding backend..."
      if build_backend "$backend_bin" -O1; then
        kill -USR1 "$pid" 2>/dev/null || true
        say "semut: backend restarted"
      else
        say "semut: build failed; still running the last good backend"
      fi
    fi
  done
  wait "$pid" 2>/dev/null || true
}

cmd_build() {
  in_app; build_launcher
  opt=-O3
  for a in "$@"; do case $a in -O*) opt=$a ;; *) die "unknown build option $a" ;; esac; done
  name=$(conf name semut)
  title=$(conf title "$name")
  id=$(conf id "com.example.$name")
  version=$(conf version 0.1.0)
  size=$(conf size 960x640)
  app=dist/$title.app

  rm -rf "$app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$LAUNCHER" "$app/Contents/MacOS/$name"
  cp -R frontend "$app/Contents/Resources/app"
  if has_backend; then
    need_tov; vendor_sdk
    say "semut: compiling backend ($opt)..."
    build_backend "$app/Contents/Resources/backend" "$opt"
    strip -x "$app/Contents/Resources/backend" 2>/dev/null || true
  fi

  icon_key=
  if [ -f icon.png ]; then
    set_dir=$(mktemp -d)/icon.iconset
    mkdir -p "$set_dir"
    for s in 16 32 128 256 512; do
      sips -z $s $s icon.png --out "$set_dir/icon_${s}x${s}.png" >/dev/null
      sips -z $((s * 2)) $((s * 2)) icon.png --out "$set_dir/icon_${s}x${s}@2x.png" >/dev/null
    done
    iconutil -c icns "$set_dir" -o "$app/Contents/Resources/icon.icns"
    rm -rf "$(dirname "$set_dir")"
    icon_key="<key>CFBundleIconFile</key><string>icon</string>"
  fi

  esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
  cat > "$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>$(esc "$name")</string>
  <key>CFBundleIdentifier</key><string>$(esc "$id")</string>
  <key>CFBundleName</key><string>$(esc "$title")</string>
  <key>CFBundleDisplayName</key><string>$(esc "$title")</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(esc "$version")</string>
  <key>CFBundleVersion</key><string>$(esc "$version")</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>SemutTitle</key><string>$(esc "$title")</string>
  <key>SemutSize</key><string>$(esc "$size")</string>
  $icon_key
</dict>
</plist>
EOF
  plutil -lint -s "$app/Contents/Info.plist"

  # Ad-hoc signature: runs on this Mac (and is required on Apple silicon).
  # For distribution, re-sign with your Developer ID and notarize.
  codesign --force --deep --sign - "$app" 2>/dev/null || say "semut: codesign failed (the app still runs locally)"

  total=$(du -sk "$app" | cut -f1)
  say "Built $app ($(awk "BEGIN { printf \"%.1f\", $total / 1024 }") MB)"
  [ -x "$app/Contents/MacOS/$name" ] && say "  launcher  $(du -h "$app/Contents/MacOS/$name" | cut -f1)"
  [ -f "$app/Contents/Resources/backend" ] && say "  backend   $(du -h "$app/Contents/Resources/backend" | cut -f1)"
  say "  frontend  $(du -sh "$app/Contents/Resources/app" | cut -f1)"
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  new) cmd_new "$@" ;;
  dev) cmd_dev "$@" ;;
  check) cmd_check "$@" ;;
  build) cmd_build "$@" ;;
  launcher) rm -f "$LAUNCHER"; build_launcher; say "$LAUNCHER" ;;
  help|-h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command $cmd (try semut help)" ;;
esac
